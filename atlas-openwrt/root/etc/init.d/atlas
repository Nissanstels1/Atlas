#!/bin/sh /etc/rc.common
START=99
STOP=10
USE_PROCD=1

start_service() {
    for service in podkop sing-box passwall passwall2 openclash; do
        if ubus call service list "{\"name\":\"$service\"}" 2>/dev/null | jsonfilter -e '@.*.instances.*.running' | grep -q true; then
            logger -t atlas "Conflicting service is active: $service"
            return 1
        fi
    done
    umask 077
    mkdir -p /var/run/atlas
    chmod 700 /var/run/atlas
    if [ ! -s /var/run/atlas/config.json ]; then
        /usr/bin/python3 /usr/lib/atlas/atlas.py boot-config >/dev/null 2>&1 || return 1
    fi
    local engine=/usr/bin/sing-box
    [ ! -x /usr/lib/atlas-engine/bin/atlas-engine ] || engine=/usr/lib/atlas-engine/bin/atlas-engine
    "$engine" check -c /var/run/atlas/config.json >/dev/null 2>&1 || return 1
    /usr/bin/python3 /usr/lib/atlas/atlas.py ingress-sync || return 1
    if ! /usr/bin/python3 /usr/lib/atlas/atlas.py dhcp-sync >/tmp/atlas-dhcp-sync.log 2>&1; then
        logger -t atlas "DNS integration failed: $(cat /tmp/atlas-dhcp-sync.log)"
        return 1
    fi
    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/atlas/atlas.py engine-run
    procd_set_param respawn 3600 5 3
    procd_set_param limits nofile="65535 65535"
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    /usr/bin/python3 /usr/lib/atlas/atlas.py ingress-restore || logger -t atlas 'Could not restore scoped TUN firewall'
    if ! /usr/bin/python3 /usr/lib/atlas/atlas.py dhcp-restore >/tmp/atlas-dhcp-restore.log 2>&1; then
        logger -t atlas "Could not fully restore dnsmasq settings: $(cat /tmp/atlas-dhcp-restore.log)"
    fi
}
