#!/bin/sh /etc/rc.common
# Restore only Atlas-owned DNS options before dnsmasq reads persistent UCI.
START=18
STOP=10

start() {
    [ -s /etc/atlas/dhcp-dns-backup.json ] || return 0
    /usr/bin/python3 /usr/lib/atlas/atlas.py dhcp-boot-restore >/tmp/atlas-early-dns-restore.log 2>&1 || logger -t atlas 'Early DNS restoration failed; backup retained'
}
